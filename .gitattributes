# Auto detect text files and perform LF normalization
* text=auto

# Python files
*.py text eol=lf
*.ipynb text eol=lf

# Markdown and documentation
*.md text eol=lf
*.txt text eol=lf

# CSV data files
*.csv text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.pdf binary
*.pptx binary
*.pbix binary
*.xls binary
*.xlsx binary
*.mp4 binary
